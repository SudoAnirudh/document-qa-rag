# OpenAI / OpenAI-Compatible API Credentials (Groq, NVIDIA NIM, OpenRouter, etc.)
OPENAI_API_KEY=your-api-key-here
# Optional: Set custom base URL (e.g. Groq: https://api.groq.com/openai/v1 | NVIDIA: https://integrate.api.nvidia.com/v1)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_GENERATION_MODEL=gpt-4o-mini

# Path Configurations
CHROMA_PATH=./chroma_db
DATA_PATH=./data

# RAG System Default Parameters
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
DEFAULT_TOP_K=5
DEFAULT_SIMILARITY_THRESHOLD=0.35
